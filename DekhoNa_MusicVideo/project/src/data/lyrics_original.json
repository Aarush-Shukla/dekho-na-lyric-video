    { "id": "V3", "name": "Verse 3", "lines": [
      { "id": "V3_L1", "text": "Kya main kahoon… jo tu sun le…" },
      { "id": "V3_L2", "text": "Laakhon chehron mein… tu mujhe chun le (Ae…)" },
      { "id": "V3_L3", "text": "Do kadam hi sahi… mere sang toh chal" },
      { "id": "V3_L4", "text": "Yoon jee loon main zindagi… apne inn do pal (Hmm…)" } ] },
    { "id": "V4", "name": "Verse 4", "lines": [
      { "id": "V4_L1", "text": "Haan, kyun karta hai bahaane" },
      { "id": "V4_L2", "text": "Tu kitna bekhabar hai?" },
      { "id": "V4_L3", "text": "Kaise tu yeh naa jaane (Ae)" },
