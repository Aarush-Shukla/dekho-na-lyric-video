      { "id": "V4_L5", "text": "Meri aankhon ke ishaare" },
      { "id": "V4_L6", "text": "Tum samjho naa (Aa…)" } ] },
    { "id": "V5", "name": "Verse 5", "lines": [
      { "id": "V5_L1", "text": "Dil tere bin dhadke naa" },
      { "id": "V5_L2", "text": "Meri palkein bhi jhapke naa" },
      { "id": "V5_L3", "text": "Har pal tujhko main dekhoon" },
      { "id": "V5_L4", "text": "Tu kyun naa jaane (Ae)" },
      { "id": "V5_L5", "text": "Chal aa tujhko bata doon" },
      { "id": "V5_L6", "text": "Meri chahat kaa afsaana" },
      { "id": "V5_L7", "text": "Jo tujhko maine paaya" },
      { "id": "V5_L8", "text": "Toh maine jaana (Aa)" } ] },
    { "id": "PC2", "name": "Pre-Chorus 2", "lines": [
      { "id": "PC2_L1", "text": "Mere haathon mein yeh mehendi" },
      { "id": "PC2_L2", "text": "Tere hone se saji hai" },
